<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#b45309" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#fcd34d" media="(prefers-color-scheme: dark)" />
    <meta
      name="description"
      content="Senior software engineer building developer platforms. I run my homelab as code with NixOS."
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Bruno Henriques" />
    <meta
      property="og:description"
      content="Senior software engineer building developer platforms. I run my homelab as code with NixOS."
    />
    <meta property="og:url" content="https://bphenriques.com/" />
    <meta property="og:image" content="https://bphenriques.com/avatar.jpg" />
    <meta property="og:image:width" content="460" />
    <meta property="og:image:height" content="460" />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href="https://bphenriques.com/" />
    <title>Bruno Henriques</title>
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>👋</text></svg>"
    />
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <main>
      <h1>Bruno Henriques</h1>
      <p class="tagline">
        Senior software engineer building developer platforms. I&nbsp;run my
        <a href="https://github.com/bphenriques/dotfiles">homelab as code</a> with NixOS.
      </p>
      <nav class="links" aria-label="profile links">
        <a href="https://github.com/bphenriques">GitHub</a>
        <a href="https://www.linkedin.com/in/bphenriques">LinkedIn</a>
        <a href="https://github.com/bphenriques/curriculum-vitae/releases/latest/download/bruno-henriques-senior-software-engineer-cv.pdf">Resume</a>
      </nav>
      <details class="homelab" open>
        <summary>{{hostCount}} hosts · {{serviceCount}} services</summary>
        <dl class="svc">
          {{#categories}}
          <div>
            <dt>{{name}}</dt>
            {{#services}}
            <dd>{{#homepage}}<a href="{{homepage}}">{{displayName}}</a>{{/homepage}}{{^homepage}}{{displayName}}{{/homepage}}</dd>
            {{/services}}
          </div>
          {{/categories}}
        </dl>
        {{#moreCount}}<p class="more">…and {{moreCount}} more</p>{{/moreCount}}
      </details>
    </main>
  </body>
</html>
